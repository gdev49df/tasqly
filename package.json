{
  "name": "tasqly",
  "version": "0.1.0",
  "private": true,
  "description": "tasqly — рабочее пространство для команд: задачи, канбан, комментарии",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute tasqly --local --file=schema.sql",
